# ─────────────────────────────────────────────────────────────
# Attack Residue Detection & Forensic Reconstruction System
# .gitignore — exclude logs, captures, and secrets
# ─────────────────────────────────────────────────────────────

# ── Secrets & credentials (NEVER commit) ─────────────────────
.env
.env.*
*.pem
*.key
*.key.pub
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ecdsa
*.pub
!authorized_keys.example
secrets/
credentials/
.aws/
.oci/
config.php
wp-config.php
*.password
*_rsa
.netrc
.pgpass
**/secrets.yaml
**/credentials.json
**/api_keys.json

# ── SSH / known_hosts ────────────────────────────────────────
.ssh/
known_hosts
known_hosts.old

# ── Runtime logs & telemetry (generated, large, noisy) ───────
*.log
logs/
/var/log/
audit/
auditd/
*.jsonl
*.ndjson
events/
telemetry/
/var/log/audit/audit.log*
syslog
auth.log

# ── Evidence stores (PDD §22 — must not leak into git) ──────
evidence/
evidence-store/
artifacts/
residue/
incidents/
*.evidence
chain-of-custody.json
manifest.sha256
case-*.json

# ── Baselines ────────────────────────────────────────────────
# Decision: baselines are DERIVED data, regenerated by
#   `cli.py baseline create`. Committing them creates noisy diffs
#   and risks leaking host inventory. Keep the schema committed,
#   keep the snapshots out.
baselines/*/
!baselines/.gitkeep
baseline.local.json
*.baseline.json

# ── Packet captures & forensic images ────────────────────────
*.pcap
*.pcapng
*.cap
*.dmp
*.mem
*.raw
*.E01
*.dd
captures/
pcap/

# ── Scan output / demo artefacts ─────────────────────────────
scan-output/
reports/generated/
*.scan.json
*.incident.json
*.timeline.txt
demo-output/

# ── Attack simulation artefacts (never commit planted residue) ─
sim-artifacts/
/opt/residue-sim/
*.simulated
SIM_*

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Test & coverage ──────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache
nosetests.xml

# ── Type checkers & linters ──────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint.d/

# ── Editors & IDEs ───────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ── Backups & temp ───────────────────────────────────────────
*.bak
*.orig
*.tmp
*.temp
*.old
*~
/tmp/
.cache/

# ── Tooling config that may hold local paths ─────────────────
*.local.json
*.local.yaml
terraform.tfstate
terraform.tfstate.backup
